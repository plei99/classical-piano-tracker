{
  "name": "tracker-web-client",
  "version": "0.1.0",
  "private": true,
  "description": "The browser client of tracker web: Preact components over the track browser's state machine",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "preact-render-to-string": "^6.6.3",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
